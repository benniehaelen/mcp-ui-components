{
  "name": "mcp-ui-components-widget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Builds for the MCP UI component widgets. Each produces a single self-contained HTML that the Python server vendors and serves as a ui:// resource.",
  "scripts": {
    "build": "cross-env INPUT=index.html vite build",
    "watch": "cross-env INPUT=index.html vite build --watch",
    "build:join": "cross-env INPUT=join-diagram.html vite build",
    "watch:join": "cross-env INPUT=join-diagram.html vite build --watch",
    "build:plan": "cross-env INPUT=query-plan.html vite build",
    "watch:plan": "cross-env INPUT=query-plan.html vite build --watch",
    "build:profile": "cross-env INPUT=query-profile.html vite build",
    "watch:profile": "cross-env INPUT=query-profile.html vite build --watch",
    "build:trace": "cross-env INPUT=trace-waterfall.html vite build",
    "watch:trace": "cross-env INPUT=trace-waterfall.html vite build --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
